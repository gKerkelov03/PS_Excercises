<Window x:Class="UI.Windows.DisciplineEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI.Windows"
        mc:Ignorable="d"
        Title="Edit Discipline" Height="450" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Name:" Margin="0,0,10,5"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Margin="0,0,0,5"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Description:" Margin="0,0,10,5"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Description}" Margin="0,0,0,5"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Year:" Margin="0,0,10,5"/>
        <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding Year}" Margin="0,0,0,5">
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="2"/>
            <ComboBoxItem Content="3"/>
            <ComboBoxItem Content="4"/>
        </ComboBox>

        <Label Grid.Row="3" Grid.Column="0" Content="Semester:" Margin="0,0,10,5"/>
        <ComboBox Grid.Row="3" Grid.Column="1" SelectedItem="{Binding Semester}" Margin="0,0,0,5">
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="2"/>
        </ComboBox>

        <Label Grid.Row="4" Grid.Column="0" Content="Credits:" Margin="0,0,10,5"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Credits}" Margin="0,0,0,5"/>

        <Label Grid.Row="5" Grid.Column="0" Content="Lecturer:" Margin="0,0,10,5"/>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Lecturer}" Margin="0,0,0,5"/>

        <Label Grid.Row="6" Grid.Column="0" Content="Max Students:" Margin="0,0,10,5"/>
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding MaxStudents}" Margin="0,0,0,5"/>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="75" Click="SaveButton_Click" Margin="0,0,10,0"/>
            <Button Content="Cancel" Width="75" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window> 